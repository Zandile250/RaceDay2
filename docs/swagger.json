    "/api/results": {
      "post": {
        "tags": [
          "Results"
        ],
        "summary": "Capture a participant's finish time and finishing position (Organiser only).",
        "description": "Send the `enrolmentId`, a `finishTime` such as \"01:23:45\" and the `position`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureResultRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureResultRequest"
